{
  "seed": 42,
  "device": "auto",
  "data": {
    "type": "csv",
    "path": "dados/serie_sintetica.csv",
    "column": "y",
    "dependencies": [
      {
        "lag": 1,
        "coefficient": 0.4
      },
      {
        "lag": 24,
        "coefficient": 0.3
      },
      {
        "lag": 168,
        "coefficient": 0.2
      },
      {
        "lag": 720,
        "coefficient": 0.1
      }
    ],
    "_comentario": "dependencies só é usado pelo 'oracle' (previsão com a fórmula verdadeira). Deve ser igual ao do notebook 01."
  },
  "experiment": {
    "context_lengths": [
      24,
      48,
      96,
      168,
      336,
      720
    ],
    "horizon": 1,
    "train_ratio": 0.7,
    "validation_ratio": 0.1,
    "test_ratio": 0.2,
    "train_stride": 1
  },
  "training": {
    "epochs": 12,
    "batch_size": 64,
    "learning_rate": 0.002,
    "weight_decay": 0.0,
    "patience": 4
  },
  "output": {
    "directory": "results",
    "run_name": "exp_classicos"
  },
  "models": [
    {
      "name": "oracle"
    },
    {
      "name": "linear_regression",
      "params": {
        "fit_intercept": true
      }
    },
    {
      "name": "arima",
      "params": {
        "p": 24,
        "d": 0,
        "q": 2
      }
    }
  ]
}